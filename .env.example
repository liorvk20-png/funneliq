# Copy this file to .env and fill in real values from Supabase project settings.
# .env itself is gitignored — never commit real keys.

# Settings > API > Project URL
SUPABASE_URL=

# Settings > API > Project API keys > anon public
# Safe to use in the browser. Used server-side too, when scoped to a user's token.
SUPABASE_ANON_KEY=

# Settings > API > Project API keys > service_role
# NEVER expose this client-side. Used only by scripts/load_csv_to_supabase.py.
SUPABASE_SERVICE_KEY=

# Settings > API > JWT Settings > JWT Secret
# Used server-side to verify a signed-in user's access token before serving data.
SUPABASE_JWT_SECRET=
