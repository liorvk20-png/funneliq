# Copy this file to .env and fill in real values from Supabase project settings.
# .env itself is gitignored — never commit real keys.

# Settings > Data API > Project URL
SUPABASE_URL=

# Settings > API Keys > Publishable key (sb_publishable_...)
# Safe to use in the browser. Used server-side too, scoped to a user's token.
SUPABASE_PUBLISHABLE_KEY=

# Settings > API Keys > Secret keys > "default" (sb_secret_...)
# NEVER expose this client-side. Used only by scripts/load_csv_to_supabase.py.
SUPABASE_SECRET_KEY= 

# No JWT secret needed: this project verifies access tokens against the
# project's public JWKS at {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# (asymmetric signing keys, the Supabase default for new projects).
